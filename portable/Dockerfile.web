ARG NODE_IMAGE=node:22-alpine
FROM ${NODE_IMAGE} AS build
WORKDIR /app
RUN npm install --global pnpm@11.25.0
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY ops/prerender.mjs ops/prerender.mjs
COPY app app
COPY lib lib
COPY portable/src portable/src
COPY portable/web portable/web
COPY public public
RUN pnpm web:build

FROM nginxinc/nginx-unprivileged:stable-alpine
COPY portable/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/outputs/web /usr/share/nginx/html
USER 101
EXPOSE 8080
